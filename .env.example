OPENAI_API_KEY=sk-...
# OPENAI_PROXY_URL=http://127.0.0.1:7897

# Public demo safety. Keep secrets server-side; never prefix them with VITE_.
GYM_DEMO_ACCESS_CODE=replace-with-a-long-random-code
AI_AUDIT_HASH_SALT=replace-with-a-different-long-random-value
UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
UPSTASH_REDIS_REST_TOKEN=replace-with-upstash-rest-token
# Vercel Marketplace may inject the equivalent names below; either pair works:
# KV_REST_API_URL=https://your-database.upstash.io
# KV_REST_API_TOKEN=replace-with-upstash-rest-token

# Non-secret limits. Values below are the application defaults.
AI_REQUESTS_PER_MINUTE=20
AI_DAILY_REQUEST_LIMIT=200
AI_DAILY_BUDGET_MICRO_USD=2000000
AI_REQUEST_RESERVE_MICRO_USD=25000
AI_BUDGET_ALERT_PERCENT=80
# AI_BUDGET_ALERT_WEBHOOK_URL=https://your-alert-endpoint.example/webhook

# Local-only escape hatch. Public Preview/Production deployments always fail closed.
AI_ALLOW_LOCAL_MEMORY_GUARD=true
