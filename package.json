{
  "name": "gym",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:full": "vercel dev --listen 3000",
    "build": "tsc -b && vite build",
    "check:ai-contracts": "node --experimental-strip-types scripts/check-ai-contracts.mjs",
    "check:api-guards": "node scripts/check-api-guards.mjs",
    "eval:workout": "node scripts/run-workout-eval.mjs",
    "eval:workout:v1": "node scripts/run-workout-eval.mjs",
    "eval:workout:v2": "node scripts/run-workout-eval-v2.mjs",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "openai": "^7.10.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.3.3",
    "undici": "^7.29.1"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vercel/node": "^5.9.5",
    "@vitejs/plugin-react": "^6.0.4",
    "oxlint": "^1.75.0",
    "typescript": "~6.0.2",
    "vercel": "^59.11.2",
    "vite": "^8.2.0",
    "vite-plugin-pwa": "^1.3.0"
  },
  "overrides": {
    "nanoid": "3.3.18"
  }
