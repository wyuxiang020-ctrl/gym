    "build:companion": "node scripts/build-companion-v4.mjs"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "1.1.0",
    "@tailwindcss/vite": "^4.3.3",
    "openai": "^7.10.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.3.3",
    "three": "0.186.1",
    "undici": "^7.29.1"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/three": "0.186.0",
    "@vercel/node": "^5.9.5",
    "@vitejs/plugin-react": "^6.0.4",
    "oxlint": "^1.75.0",
    "typescript": "~6.0.2",
    "vercel": "^59.11.2",
    "vite": "^8.2.0",
    "vite-plugin-pwa": "^1.3.0"
  },
  "overrides": {
    "nanoid": "3.3.18"
  }
