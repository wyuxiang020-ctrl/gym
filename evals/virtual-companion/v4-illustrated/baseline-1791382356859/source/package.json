{
  "name": "gym",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:full": "vercel dev --listen 3000",
    "build": "tsc -b && vite build",
    "check:ai-contracts": "node --experimental-strip-types scripts/check-ai-contracts.mjs",
    "check:api-guards": "node scripts/check-api-guards.mjs",
    "check:demo-safety": "node --experimental-strip-types scripts/check-demo-safety.mts",
    "check:workout-save": "node scripts/check-workout-save.mjs",
    "check:workout-browser": "node scripts/check-workout-browser.mjs",
    "eval:workout:v3": "node scripts/run-workout-save-v3.mjs",
    "replay:workout:v3": "node scripts/replay-workout-save-v3.mjs",
    "eval:workout": "node scripts/run-workout-eval.mjs",
    "eval:workout:v1": "node scripts/run-workout-eval.mjs",
    "eval:workout:v2": "node scripts/run-workout-eval-v2.mjs",
    "eval:food": "node scripts/run-food-eval.mjs",
    "eval:food:v1": "node scripts/run-food-eval.mjs",
    "assets:food-eval": "node scripts/create-food-eval-variants.mjs",
